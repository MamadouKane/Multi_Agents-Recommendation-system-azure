# Copy to .env for local development.
# None of these values are secrets: authentication uses Managed Identity in Azure
# and DefaultAzureCredential (az login) locally. Endpoints are emitted as Bicep
# outputs and injected automatically by azd.

AZURE_OPENAI_ENDPOINT=https://<name>.openai.azure.com/
# Deployment NAME, not model name. v1 model per ADR-007 (gpt-5.6-luna quota was refused).
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# API version: to be settled on day 1 against the GPT-5 family (v1 endpoint vs dated api-version).

AZURE_SEARCH_ENDPOINT=https://<name>.search.windows.net
AZURE_SEARCH_INDEX_NAME=coffee-knowledge

AZURE_COSMOS_ENDPOINT=https://<name>.documents.azure.com:443/
AZURE_COSMOS_DATABASE=coffeeshop
AZURE_COSMOS_PRODUCTS_CONTAINER=products
AZURE_COSMOS_CONVERSATIONS_CONTAINER=conversations

AZURE_STORAGE_BLOB_ENDPOINT=https://<name>.blob.core.windows.net/
AZURE_STORAGE_IMAGES_CONTAINER=product-images
AZURE_STORAGE_MODELS_CONTAINER=model-artefacts
# The published recommender (`make publish-model`). Empty to load RECOMMENDATIONS_PATH instead.
RECOMMENDATIONS_BLOB=coffee-reco-apriori/current/recommendations.json
RECOMMENDATIONS_PATH=data/processed/recommendations.json

AZURE_CONTENT_SAFETY_ENDPOINT=https://<name>.cognitiveservices.azure.com/

# Names the target only: ingestion requires an Entra ID identity (DisableLocalAuth).
APPLICATIONINSIGHTS_CONNECTION_STRING=

# USD per million tokens, gpt-5.4-mini (OpenAI list price; confirm the Data Zone EU price).
CHAT_INPUT_USD_PER_MILLION=0.75
CHAT_OUTPUT_USD_PER_MILLION=4.50

# Application
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAX_HISTORY_TURNS=20
