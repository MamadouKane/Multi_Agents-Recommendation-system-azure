# Copy to .env for local development.
# None of these values are secrets: authentication uses Managed Identity in Azure
# and DefaultAzureCredential (az login) locally. Endpoints are emitted as Bicep
# outputs and injected automatically by azd.

AZURE_OPENAI_ENDPOINT=https://<name>.openai.azure.com/
# Deployment NAME, not model name. Interim model until gpt-5.6-luna quota is granted (ADR-007).
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# API version: to be settled on day 1 against the GPT-5 family (v1 endpoint vs dated api-version).

AZURE_SEARCH_ENDPOINT=https://<name>.search.windows.net
AZURE_SEARCH_INDEX_NAME=coffee-knowledge

AZURE_COSMOS_ENDPOINT=https://<name>.documents.azure.com:443/
AZURE_COSMOS_DATABASE=coffeeshop
AZURE_COSMOS_PRODUCTS_CONTAINER=products
AZURE_COSMOS_CONVERSATIONS_CONTAINER=conversations

AZURE_STORAGE_ACCOUNT=<name>
AZURE_STORAGE_IMAGES_CONTAINER=product-images

AZURE_CONTENT_SAFETY_ENDPOINT=https://<name>.cognitiveservices.azure.com/

APPLICATIONINSIGHTS_CONNECTION_STRING=

# Application
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAX_HISTORY_TURNS=20
